# ═══════════════════════════════════════════════════
#  AI PROVIDERS — at least ONE is required
# ═══════════════════════════════════════════════════

# OpenRouter — 50 free requests/day
# Get: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral — free tier, works globally
# Get: https://console.mistral.ai/
MISTRAL_API_KEY=

# Groq — free tier (may be network-restricted in some regions)
# Get: https://console.groq.com/keys
GROQ_API_KEY=

# ═══════════════════════════════════════════════════
#  OPTIONAL SERVICES
# ═══════════════════════════════════════════════════

# Hugging Face — for image generation
# Get: https://huggingface.co/settings/tokens
HF_TOKEN=

# ═══════════════════════════════════════════════════
#  MODELS (defaults are fine)
# ═══════════════════════════════════════════════════

OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
MISTRAL_MODEL=mistral-small-latest
VISION_MODEL=google/gemma-4-31b-it:free

# ═══════════════════════════════════════════════════
#  LOCAL WHISPER
# ═══════════════════════════════════════════════════

# tiny (fastest) | base (default) | small (better)
WHISPER_MODEL=base